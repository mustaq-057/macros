{
  "appId": "com.jazzmacros.app",
  "appName": "JazzMacros",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0D0D0D",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0D0D0D"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#1F5D4C",
      "sound": "beep.wav"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  }
}
